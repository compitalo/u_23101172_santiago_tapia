	CREATE SCHEMA auditoria;
	REVOKE ALL ON SCHEMA auditoria FROM PUBLIC;
	
	-- 2. Crear la tabla de auditoría
	CREATE TABLE auditoria.cambios_clientes (
	    id_evento        BIGSERIAL PRIMARY KEY,
